{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/brief", "destination": "https://book.buildmystart-up.com/api/brief" },
    { "source": "/brief", "destination": "/brand-quiz" },
    { "source": "/start", "destination": "/brand-quiz" }
  ],
  "redirects": [
    { "source": "/form", "destination": "/brief", "permanent": false }
  ]
}
